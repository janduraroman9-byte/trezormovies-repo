<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.trezormovies" name="Trezor Movies" version="1.0.0" provider-name="Trezor">
    <requires>
        <import addon="xbmc.python" version="1.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum></forum>
        <website></website>
        <email></email>
        <source></source>
        <assets>
            <icon>resources/icon_final.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
        <summary lang="cs_CZ">Soukromá filmová databáze Trezor Movies</summary>
        <description lang="cs_CZ">Doplněk pro sledování vlastních streamů a seriálů synchronizovaných ze Synology NAS.</description>
        <disclaimer lang="cs_CZ"></disclaimer>
    </extension>
</addon>

<addon id="repository.trezormovies" name="TrezorMovies Repository" version="1.0.0" provider-name="Angrestovnik">
    <extension point="xbmc.addon.repository" name="TrezorMovies Repository">
    <info compressed="false">http://trezormovies.wz.cz/addons.xml</info>
    <checksum>http://trezormovies.wz.cz/addons.xml.md5</checksum>
    <datadir zip="true">http://trezormovies.wz.cz/</datadir>
</extension>
    <extension point="xbmc.addon.metadata">
        <summary>Repozitář pro doplněk TrezorMovies</summary>
        <description>Instalace a automatické aktualizace doplňku TrezorMovies.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
